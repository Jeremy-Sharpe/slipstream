[Unit]
Description=Slipstream self-hosted Supabase runtime
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/slipstream-supabase-start
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
