#!/usr/bin/env bash
set -euo pipefail

readonly RELEASE_ROOT="${SLIPSTREAM_RELEASE_ROOT:-/opt/slipstream/current}"
readonly RUNTIME_ROOT="${SLIPSTREAM_SUPABASE_ROOT:-/opt/slipstream/supabase-runtime}"
readonly ENV_FILE="${SLIPSTREAM_SUPABASE_ENV:-/etc/slipstream/supabase.env}"
readonly SUPABASE_VERSION="2.117.0"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Slipstream Supabase startup must run as root" >&2
  exit 1
fi
for command in awk curl docker grep install mktemp npm sed ss; do
  command -v "$command" >/dev/null || {
    echo "Required command is missing: $command" >&2
    exit 1
  }
done
[[ -f "$RELEASE_ROOT/supabase/config.toml" ]] || {
  echo "Supabase config is missing from $RELEASE_ROOT" >&2
  exit 1
}

install -d -m 0700 -o root -g root "$RUNTIME_ROOT/migrations"
install -m 0600 -o root -g root \
  "$RELEASE_ROOT/supabase/config.toml" "$RUNTIME_ROOT/config.toml"
if [[ -f "$RELEASE_ROOT/supabase/seed.sql" ]]; then
  install -m 0600 -o root -g root "$RELEASE_ROOT/supabase/seed.sql" "$RUNTIME_ROOT/seed.sql"
fi
for migration in "$RELEASE_ROOT"/supabase/migrations/*.sql; do
  install -m 0600 -o root -g root "$migration" "$RUNTIME_ROOT/migrations/$(basename "$migration")"
done

supabase() {
  npm exec --yes --package="supabase@$SUPABASE_VERSION" -- supabase "$@"
}

cd "$RUNTIME_ROOT"
supabase start -x studio,imgproxy,inbucket,edge-runtime,logflare,vector,supavisor
supabase migration up --local

status="$(supabase status -o env)"
api_url="$(printf '%s\n' "$status" | sed -n 's/^API_URL="\([^"]*\)"$/\1/p')"
service_key="$(printf '%s\n' "$status" | sed -n 's/^SERVICE_ROLE_KEY="\([^"]*\)"$/\1/p')"
[[ "$api_url" == "http://127.0.0.1:54321" ]] || {
  echo "Supabase API URL is not the expected loopback origin" >&2
  exit 1
}
[[ "$service_key" =~ ^eyJ[A-Za-z0-9._-]+$ ]] || {
  echo "Supabase CLI returned an invalid service-role key" >&2
  exit 1
}

install -d -m 0750 -o root -g root "$(dirname "$ENV_FILE")"
temporary="$(mktemp "${ENV_FILE}.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
chmod 0600 "$temporary"
printf 'SUPABASE_URL=%s\nSUPABASE_SERVICE_ROLE_KEY=%s\n' "$api_url" "$service_key" >"$temporary"
install -m 0600 -o root -g root "$temporary" "$ENV_FILE"

# The service-role credential never leaves this host. Fail closed if Docker
# publishes either database port beyond loopback.
if ss -H -ltn '( sport = :54321 or sport = :54322 )' | awk '{print $4}' | grep -Evq '^(127\.0\.0\.1|\[::1\]):'; then
  echo "Supabase published a database port beyond loopback" >&2
  exit 1
fi

curl --fail --silent --show-error --max-time 5 \
  -H "apikey: $service_key" -H "Authorization: Bearer $service_key" \
  "$api_url/rest/v1/companies?select=id&limit=1" >/dev/null
echo "Slipstream Supabase is ready on loopback with reviewed migrations applied"
