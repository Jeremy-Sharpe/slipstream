# Copy to .env inside the app you are running. Never commit .env.

# Supabase (apps/api and apps/web)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # apps/api only, never shipped to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reasoning (apps/api)
ANTHROPIC_API_KEY=

# Speech (apps/api, apps/coach)
ELEVENLABS_API_KEY=

# Lead discovery (apps/api)
ORIGAMI_API_KEY=                    # og_live_...

# Cross-app URLs
API_BASE_URL=http://localhost:8000  # apps/web server-side calls to FastAPI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
COACH_WS_URL=ws://localhost:8000/ws/coach
WEB_ORIGIN=http://localhost:3000    # apps/api CORS allow-list
