# Copy to .env at the repo root (UI, coach) and to api/.env. Never commit .env.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=                       # api only
SUPABASE_SERVICE_ROLE_KEY=          # api only, never shipped to the browser

# Reasoning (api). REASONING_MODEL picks the provider by name: claude-* uses Anthropic,
# gpt-* uses OpenAI, anything else (vendor/model) goes through OpenRouter.
REASONING_MODEL=gpt-5.4
OPENAI_API_KEY=                     # also used for embeddings (text-embedding-3-small)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Speech (api, coach)
ELEVENLABS_API_KEY=

# Lead discovery (api)
ORIGAMI_API_KEY=                    # og_live_...

# Cross-app URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
COACH_WS_URL=ws://localhost:8000/ws/coach
WEB_ORIGIN=http://localhost:3000    # api CORS allow-list
