{
  "name": "slipstream-coach",
  "productName": "Slipstream Coach",
  "version": "0.1.0",
  "description": "Transparent live sales coaching overlay for Slipstream",
  "author": "Slipstream contributors",
  "main": "src/main.js",
  "license": "GPL-3.0-only",
  "scripts": {
    "build:renderer": "esbuild src/renderer.js --bundle --platform=browser --format=iife --outfile=.build/renderer.js",
    "start": "npm run build:renderer && electron-forge start",
    "package": "npm run build:renderer && electron-forge package",
    "make": "npm run build:renderer && electron-forge make",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@elevenlabs/client": "1.25.0",
    "electron-squirrel-startup": "1.0.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "electron": "44.3.0",
    "esbuild": "0.25.9"
  }
}
