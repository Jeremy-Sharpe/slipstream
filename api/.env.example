ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_ORIGINS=http://localhost:3000

# Optional for health/config startup; data endpoints require a configured repository.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Serves reasoning and embeddings when the native OpenAI or Anthropic key is absent.
OPENROUTER_API_KEY=
SCORECARD_JUDGE_MODEL=deepseek/deepseek-v3.2
ELEVENLABS_API_KEY=
# Required in production when ElevenLabs is enabled. Send as X-Slipstream-Ingest-Token.
INGEST_TOKEN=
ORIGAMI_API_KEY=
# Optional provider-neutral delivery seam for approved CRM updates. Use 32+ random bytes.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Optional real email delivery. Approval remains separate from sending.
RESEND_API_KEY=
RESEND_FROM=
REASONING_MODEL=gpt-5.4
EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional credential-free reasoning endpoint. Loopback /v1 URLs only.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=slipstream-qwen2.5-1.5b-instruct-q4-k-m
ORIGAMI_BASE_URL=https://origami.chat/api/v3
RESEND_BASE_URL=https://api.resend.com
